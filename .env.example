# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_DB=swiftpay
POSTGRES_USER=swiftpay
POSTGRES_PASSWORD=change-me

# HS256 needs at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=900

APP_TIMEZONE=Europe/Istanbul

# Comma separated, explicit origins only (no *)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
