{
  "info": {
    "name": "SwiftPay Money Transfer API",
    "description": "Run folders in order (1 -> 6). Demo users: ecem / ali, password Test1234!. Start the backend with `docker compose up` first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('X-Trace-Id header present', () => pm.expect(pm.response.headers.has('X-Trace-Id')).to.be.true);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenAli",
      "value": ""
    },
    {
      "key": "sourceAccountId",
      "value": "1"
    },
    {
      "key": "receiverIban",
      "value": "TR690006200000000000002001"
    },
    {
      "key": "idemKey",
      "value": ""
    },
    {
      "key": "lastTransferId",
      "value": ""
    },
    {
      "key": "startDate",
      "value": ""
    },
    {
      "key": "endDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (ecem) - saves {{token}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ecem\",\n  \"password\": \"Test1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('token present', () => pm.expect(j.data.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('token', j.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (ali) - saves {{tokenAli}} (used for IDOR test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ali\",\n  \"password\": \"Test1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenAli', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ecem\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "const j = pm.response.json();",
                  "pm.test('error code INVALID_CREDENTIALS', () => pm.expect(j.code).to.eql('INVALID_CREDENTIALS'));",
                  "pm.test('error has message and traceId', () => { pm.expect(j.message).to.be.a('string'); pm.expect(j.traceId).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Accounts",
      "item": [
        {
          "name": "List my accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('balances are strings', () => pm.expect(d[0].balance).to.be.a('string'));",
                  "pm.collectionVariables.set('sourceAccountId', d[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Remaining limits (today / month)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/limits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "limits"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('limits structure', () => { pm.expect(d.daily.remaining).to.be.a('string'); pm.expect(d.monthly.remaining).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Transfers (happy path)",
      "item": [
        {
          "name": "Create transfer (new idempotency key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": {{sourceAccountId}},\n  \"receiverIban\": \"{{receiverIban}}\",\n  \"amount\": \"1500.00\",\n  \"description\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generates a fresh Idempotency-Key into {{idemKey}}. Run before the Idempotency folder."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idemKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('completed', () => pm.expect(d.status).to.eql('COMPLETED'));",
                  "pm.collectionVariables.set('lastTransferId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transfer by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfers/{{lastTransferId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers",
                "{{lastTransferId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('same id', () => pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get('lastTransferId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my transfers (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfers?page=0&size=10&sort=createdAt,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('page structure', () => { pm.expect(d.content).to.be.an('array'); pm.expect(d.totalPages).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List by date interval (last 7 days)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfers?startDate={{startDate}}&endDate={{endDate}}&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "{{startDate}}"
                },
                {
                  "key": "endDate",
                  "value": "{{endDate}}"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); pm.collectionVariables.set('endDate', d.toISOString().slice(0,10));",
                  "d.setDate(d.getDate() - 7); pm.collectionVariables.set('startDate', d.toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List - invalid date range (start > end)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfers?startDate=2026-05-31&endDate=2026-05-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-05-31"
                },
                {
                  "key": "endDate",
                  "value": "2026-05-01"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "const j = pm.response.json();",
                  "pm.test('error code INVALID_DATE_RANGE', () => pm.expect(j.code).to.eql('INVALID_DATE_RANGE'));",
                  "pm.test('error has message and traceId', () => { pm.expect(j.message).to.be.a('string'); pm.expect(j.traceId).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Idempotency",
      "item": [
        {
          "name": "Replay - same key + same payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": {{sourceAccountId}},\n  \"receiverIban\": \"{{receiverIban}}\",\n  \"amount\": \"1500.00\",\n  \"description\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses the SAME {{idemKey}} as 'Create transfer'. Must not create a second transfer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 (replay)', () => pm.response.to.have.status(200));",
                  "pm.test('Idempotent-Replayed header', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('same transfer id', () => pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get('lastTransferId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflict - same key + different amount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": {{sourceAccountId}},\n  \"receiverIban\": \"{{receiverIban}}\",\n  \"amount\": \"2500.00\",\n  \"description\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "const j = pm.response.json();",
                  "pm.test('error code IDEMPOTENCY_KEY_CONFLICT', () => pm.expect(j.code).to.eql('IDEMPOTENCY_KEY_CONFLICT'));",
                  "pm.test('error has message and traceId', () => { pm.expect(j.message).to.be.a('string'); pm.expect(j.traceId).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing Idempotency-Key header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": {{sourceAccountId}},\n  \"receiverIban\": \"{{receiverIban}}\",\n  \"amount\": \"100.00\",\n  \"description\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "const j = pm.response.json();",
                  "pm.test('error code IDEMPOTENCY_KEY_REQUIRED', () => pm.expect(j.code).to.eql('IDEMPOTENCY_KEY_REQUIRED'));",
                  "pm.test('error has message and traceId', () => { pm.expect(j.message).to.be.a('string'); pm.expect(j.traceId).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
